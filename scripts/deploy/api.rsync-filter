# rsync-Filter fuer den api/-Upload nach public_html/SKM/api/ (scripts/deploy-cyon.js).
# Der Upload laeuft ohne --delete.

# Secrets, nur auf dem Server
- /_config.php
# Laufzeitdaten, nur auf dem Server; data/.htaccess kommt aus dem Repo
+ /data/.htaccess
- /data/*
# Composer-Abhaengigkeiten: eigener Schritt in deploy-cyon.js (Upload nach vendor_next/, dann Tausch),
# nie ueber den normalen api-Upload. vendor_next/ und vendor_old/ gehoeren nur zu diesem Schritt.
- /vendor/
- /vendor_next/
- /vendor_old/
- /composer.phar
- /composer-setup.php
# Hosting-spezifisch
- /.user.ini
- /php.ini
- /error_log
- .DS_Store
