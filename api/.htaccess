RewriteEngine On
# Route /api/multisig/... to multisig.php
RewriteRule ^multisig($|/.*$) /api/multisig.php [L,QSA]
# Route /api/trade/... to trade.php
RewriteRule ^trade($|/.*$) /api/trade.php [L,QSA]
# Route /api/admin/... to admin.php
RewriteRule ^admin($|/.*$) /api/admin.php [L,QSA]
# Route /api/federation to federation.php (SEP-2 via backend, Backlog P1.2)
RewriteRule ^federation$ /api/federation.php [L,QSA]
